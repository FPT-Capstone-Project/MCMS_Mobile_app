# Backend API Base URL (Do not include /api at the end)
EXPO_PUBLIC_API_URL=https://backend-75e1.onrender.com

# Database camera_id used by /api/cameras/{cameraId}, not the Imou device ID
EXPO_PUBLIC_CAMERA_ID=

# HTTP Timeout in milliseconds (default: 15000ms = 15s)
EXPO_PUBLIC_API_TIMEOUT=15000

# App Environment: development | staging | production
EXPO_PUBLIC_APP_ENV=development
