# Copy this file to .env and replace the API URL with your backend URL.
# Do not include /api at the end. EXPO_PUBLIC_* values are embedded in the app bundle.
EXPO_PUBLIC_API_URL=https://your-api.example.com

# Database camera_id used by /api/cameras/{cameraId}, not the Imou device ID
EXPO_PUBLIC_CAMERA_ID=3

# HTTP Timeout in milliseconds (default: 15000ms = 15s)
EXPO_PUBLIC_API_TIMEOUT=15000

# App Environment: development | staging | production
EXPO_PUBLIC_APP_ENV=development
