{
  "expo": {
    "name": "MCMS_Mobile_App",
    "slug": "MCMS_Mobile_App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mcms-mark.png",
    "scheme": "mcms",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#147C3E",
        "foregroundImage": "./assets/mcms-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/mcms-mark.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      "expo-font",
      "expo-video",
      "expo-asset",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/mcms-mark.png",
          "imageWidth": 120
        }
      ]
    ]
  }
}
